/* CETUS — calm, high-contrast clinical theme */

QWidget {
    background-color: #f4f6f8;
    color: #1f2933;
    font-size: 15px;
}

QLabel#H1 { font-size: 28px; font-weight: 700; color: #14303a; }
QLabel#H2 { font-size: 21px; font-weight: 600; color: #14303a; }
QLabel#Muted { color: #5f6b7a; }
QLabel#Big { font-size: 40px; font-weight: 700; color: #2a9d8f; }

QFrame#Card {
    background-color: #ffffff;
    border: 1px solid #e1e6eb;
    border-radius: 12px;
}

QFrame#Overlay {
    background-color: rgba(20, 32, 40, 0.78);
}
QFrame#OverlayCard {
    background-color: #ffffff;
    border-radius: 16px;
}

QPushButton {
    background-color: #ffffff;
    border: 1px solid #c5ced6;
    border-radius: 9px;
    padding: 9px 16px;
    min-height: 22px;
}
QPushButton:hover { background-color: #eef2f5; }
QPushButton:disabled { color: #9aa6b1; background-color: #f0f2f4; }

QPushButton#Primary {
    background-color: #2a9d8f;
    color: #ffffff;
    border: none;
    font-weight: 600;
}
QPushButton#Primary:hover { background-color: #21867a; }
QPushButton#Primary:disabled { background-color: #a7d3cc; color: #eef7f5; }

QPushButton#Panic {
    background-color: #e63946;
    color: #ffffff;
    border: none;
    border-radius: 12px;
    font-size: 20px;
    font-weight: 800;
    padding: 12px 26px;
}
QPushButton#Panic:hover { background-color: #c92f3b; }

QPushButton#Danger { color: #c92f3b; border-color: #e6a3a8; }

QLineEdit, QComboBox, QSpinBox, QPlainTextEdit, QTextEdit {
    background-color: #ffffff;
    border: 1px solid #c5ced6;
    border-radius: 8px;
    padding: 7px 9px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QPlainTextEdit:focus {
    border: 1px solid #2a9d8f;
}

QSlider::groove:horizontal {
    height: 10px; border-radius: 5px; background: #d7dee4;
}
QSlider::sub-page:horizontal { background: #2a9d8f; border-radius: 5px; }
QSlider::handle:horizontal {
    background: #ffffff; border: 2px solid #2a9d8f;
    width: 28px; height: 28px; margin: -10px 0; border-radius: 14px;
}

QListWidget, QTableWidget {
    background-color: #ffffff; border: 1px solid #e1e6eb; border-radius: 10px;
}
QListWidget::item { padding: 10px; }
QListWidget::item:selected { background-color: #e0f2ef; color: #14303a; }

QHeaderView::section {
    background-color: #eef2f5; padding: 6px; border: none; font-weight: 600;
}
QCheckBox { spacing: 8px; }

/* Settings: left navigation list (icon + label rows). */
QListWidget#SettingsNav {
    background-color: #ffffff; border: 1px solid #e1e6eb; border-radius: 10px; padding: 6px;
    font-size: 15px; outline: 0;
}
QListWidget#SettingsNav::item {
    padding: 11px 12px; border-radius: 8px; margin: 2px; color: #1f2933;
}
QListWidget#SettingsNav::item:hover { background-color: #eef2f5; }
QListWidget#SettingsNav::item:selected { background-color: #2a9d8f; color: #ffffff; }

/* Settings: grouped sections on the right pane. */
QGroupBox {
    background-color: #ffffff; border: 1px solid #e1e6eb; border-radius: 12px;
    margin-top: 16px; padding: 16px 16px 14px 16px; font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin; subcontrol-position: top left;
    left: 14px; padding: 2px 8px; color: #14303a; font-size: 16px;
}

/* Keyboard-only mode: highlight the intensity axis that +/- will move. */
QLabel[activeAxis="true"] { color: #21867a; font-weight: 700; }
QSlider[activeAxis="true"]::groove:horizontal {
    background: #cdece7; border: 1px solid #2a9d8f; border-radius: 3px;
}
QSlider[activeAxis="true"]::handle:horizontal { background: #21867a; }

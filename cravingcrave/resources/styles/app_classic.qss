/* CETUS — Classic Windows theme: flat grey, square corners, blue accent. */

QWidget { background-color: #f0f0f0; color: #000000; }

QLabel#H1 { font-size: 22px; font-weight: 700; color: #000000; }
QLabel#H2 { font-size: 17px; font-weight: 700; color: #000000; }
QLabel#Muted { color: #555555; }

QFrame#Card { background-color: #ffffff; border: 1px solid #a0a0a0; border-radius: 0; }
QFrame#OverlayCard { background-color: #ffffff; border-radius: 0; }

QGroupBox {
    background-color: #ffffff; border: 1px solid #a0a0a0; border-radius: 0; margin-top: 16px;
}
QGroupBox::title { color: #000000; }

QPushButton {
    background-color: #e1e1e1; color: #000000; border: 1px solid #adadad; border-radius: 0;
    padding: 6px 14px;
}
QPushButton:hover { background-color: #e5f1fb; border-color: #0078d7; }
QPushButton:disabled { color: #6d6d6d; background-color: #cccccc; }
QPushButton#Primary { background-color: #0078d7; color: #ffffff; border: 1px solid #0067b8; }
QPushButton#Primary:hover { background-color: #106ebe; }
QPushButton#Danger { color: #a80000; border-color: #d99; }

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QPlainTextEdit, QTextEdit {
    background-color: #ffffff; color: #000000; border: 1px solid #7a7a7a; border-radius: 0;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QPlainTextEdit:focus {
    border: 1px solid #0078d7;
}

QListWidget, QTableWidget { background-color: #ffffff; border: 1px solid #7a7a7a; border-radius: 0; }
QListWidget::item:selected { background-color: #0078d7; color: #ffffff; }
QHeaderView::section { background-color: #e1e1e1; color: #000000; border: 1px solid #a0a0a0; }

QListWidget#SettingsNav { background-color: #ffffff; border: 1px solid #7a7a7a; border-radius: 0; }
QListWidget#SettingsNav::item { border-radius: 0; color: #000000; }
QListWidget#SettingsNav::item:hover { background-color: #e5f1fb; }
QListWidget#SettingsNav::item:selected { background-color: #0078d7; color: #ffffff; }

QSlider::sub-page:horizontal { background: #0078d7; }
QSlider::handle:horizontal { border: 2px solid #0078d7; border-radius: 0; }
